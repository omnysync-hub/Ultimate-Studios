# Copy to `.env.local` and fill in. Never commit real secrets.

# Canonical site URL (required for SEO — do not leave example.com in production)
NEXT_PUBLIC_SITE_URL=https://ultimatecineverse.com

# Google Analytics 4 measurement ID (optional; must look like G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R4WYQVR4LF

# Sanity CMS — Studio at /studio (login with Sanity project members)
NEXT_PUBLIC_SANITY_PROJECT_ID=pbq9a26l
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Write token (Editor) — migration scripts + blog reactions/comments APIs. Never expose to the browser.
SANITY_API_WRITE_TOKEN=

# Contact form delivery via Resend (https://resend.com) — no new npm package required
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@ultimatecineverse.com
# Verified sender after you add a domain in Resend (dev can use onboarding@resend.dev)
CONTACT_FROM_EMAIL=Ultimate Cineverse <onboarding@resend.dev>
